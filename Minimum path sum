class Solution:
    def minPathSum(self, grid: List[List[int]]) -> int:
        rows = len(grid)
        cols = len(grid[0])

        dp = [0] * cols
        dp[0] = grid[0][0]

        # First row
        for c in range(1, cols):
            dp[c] = dp[c - 1] + grid[0][c]

        # Remaining rows
        for r in range(1, rows):
            dp[0] += grid[r][0]

            for c in range(1, cols):
                dp[c] = min(dp[c], dp[c - 1]) + grid[r][c]

        return dp[-1]
