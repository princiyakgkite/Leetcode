class Solution:
    def fullJustify(self, words: List[str], maxWidth: int) -> List[str]:
        result = []
        i = 0

        while i < len(words):
            line_length = len(words[i])
            j = i + 1

            while j < len(words) and line_length + 1 + len(words[j]) <= maxWidth:
                line_length += 1 + len(words[j])
                j += 1

            line = ""
            num_words = j - i
            total_chars = sum(len(word) for word in words[i:j])
            total_spaces = maxWidth - total_chars

            # Last line or only one word
            if j == len(words) or num_words == 1:
                line = " ".join(words[i:j])
                line += " " * (maxWidth - len(line))
            else:
                space_between = total_spaces // (num_words - 1)
                extra_spaces = total_spaces % (num_words - 1)

                for k in range(num_words - 1):
                    line += words[i + k]
                    line += " " * (space_between + (1 if k < extra_spaces else 0))
                line += words[j - 1]

            result.append(line)
            i = j

        return result
